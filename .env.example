# Copy this file to .env for local runs, or set these as environment
# variables in your hosting provider's dashboard (Railway, Render, Fly.io, etc.)

PORT=3000

# Admin panel login (Basic Auth) — protects /admin and all /api/admin/* routes.
# CHANGE THESE before deploying. Anyone with these credentials can
# upload/replace/delete tracks.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-something-strong
